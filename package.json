{
	"name": "obsidian-browser-bookmarks-sync",
	"version": "1.0.0",
	"description": "Import Safari, Chrome or Firefox bookmarks into Obsidian as individual Markdown notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --import ./tests/mocks/register.js --test 'tests/**/*.test.ts'"
	},
	"author": "Abdellah Chadidi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/chadidi/obsidian-browser-bookmarks.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"bplist-parser": "^0.3.2"
	}
}
